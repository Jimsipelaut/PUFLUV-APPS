<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- Foto Partner Memenuhi Seluruh Widget -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Partner Moment" />

    <!-- Placeholder jika belum ada foto -->
    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:background="@drawable/widget_bg"
        android:text="PUFLUV\nBelum ada moment baru"
        android:textColor="#E4DCD3"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Gradient Overlay Atas & Bawah Gelap Transparan -->
    <ImageView
        android:id="@+id/widget_scrim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_scrim"
        android:scaleType="fitXY"
        android:contentDescription="Gradient Overlay" />

    <!-- Bagian Atas Kanan: Countdown Anniversary / Tanggal Penting -->
    <LinearLayout
        android:id="@+id/widget_countdown_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="ANNIVERSARY"
            android:textColor="#E6D3C3"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_countdown_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="8"
                android:textColor="#FAF6F1"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="hari lagi"
                android:textColor="#E4DCD3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bagian Bawah Kiri: Caption & Timestamp / Mood -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="lagi makan nih hehe"
            android:textColor="#FAF6F1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="2 jam lalu · 🥰"
            android:textColor="#D4CCC3"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
