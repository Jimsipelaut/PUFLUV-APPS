// DRAFT — belum diuji. Wajib diuji di Fase 5 (Firebase Emulator / Rules Playground)
// terhadap skenario privasi: user C tidak boleh membaca apa pun milik couple A+B.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function coupleDoc(cid) {
      return get(/databases/$(database)/documents/couples/$(cid));
    }

    function isMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(cid))
        && (request.auth.uid == coupleDoc(cid).data.memberA
            || request.auth.uid == coupleDoc(cid).data.memberB);
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Join: get per kode diizinkan, list ditolak (kode tidak bisa dienumerasi).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.memberA == request.auth.uid;
      allow update, delete: if false;
    }

    match /couples/{cid} {
      // get diizinkan untuk calon member selama slot memberB kosong (alur Join).
      allow get: if isMember(cid)
        || (signedIn() && resource.data.memberB == null);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.memberA == request.auth.uid
        && request.resource.data.memberB == null;
      // Satu-satunya update: mengisi memberB dengan uid sendiri.
      allow update: if signedIn()
        && resource.data.memberB == null
        && request.resource.data.memberB == request.auth.uid
        && request.resource.data.memberA == resource.data.memberA
        && request.resource.data.inviteCode == resource.data.inviteCode;
      allow delete: if false;

      match /moments/{uid} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid)
          && request.auth.uid == uid
          && request.resource.data.photoBase64 is string
          && request.resource.data.photoBase64.size() < 700000
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500;
        allow delete: if isMember(cid) && request.auth.uid == uid;
      }

      match /importantDates/{dateId} {
        allow read, write: if isMember(cid);
      }

      // P1
      match /reactions/{uid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && request.auth.uid == uid;
      }
    }
  }
}
